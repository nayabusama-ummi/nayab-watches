# NAYAB Watchmaking Atelier — Backend Environment Configuration
# Copy this file to .env and provide appropriate values.

# Runtime environment (development | production)
NODE_ENV=production

# Service port
PORT=5000

# PostgreSQL connection string
# For production with SSL/pooling (e.g. Supabase, Neon, AWS RDS, Render Postgres):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@ep-sample.us-east-1.aws.neon.tech/nayab_db?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nayab_db?schema=public"

# 32+ character high-entropy secret used to sign HttpOnly JWT session tokens
# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"

# Name of the authentication cookie
COOKIE_NAME="nayab_auth_token"

# Comma-separated list of allowed frontend origins for CORS
# In production, specify your exact deployed frontend domains (NO trailing slashes)
CORS_ORIGIN="https://nayab-watches.vercel.app,http://localhost:3000"

# Cross-site cookie configuration:
# Set to 'true' if frontend and backend are hosted on separate domains/origins (e.g. vercel.app and onrender.com)
# This configures SameSite=None; Secure=true so browsers include the HttpOnly cookie in cross-origin fetch requests.
COOKIE_CROSS_SITE=false

# Production seed policy:
# Set to 'true' ONLY if you explicitly want to create demo client and admin accounts in production.
# In development (NODE_ENV != 'production'), demo accounts are created by default.
SEED_DEMO_ACCOUNTS=false

# Optional custom password when seeding an initial admin user
# SEED_ADMIN_PASSWORD="YourSecureAdminPassword123!"
